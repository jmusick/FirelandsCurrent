---
import { Link, Mail } from '@lucide/astro';

interface Props { url: string; title: string }
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
// Lucide dropped brand logos, so these are inline marks (Simple Icons paths); they follow the button's text color.
const targets = [
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, path: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z' },
  { name: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${t}`, path: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z' },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
  { name: 'Reddit', href: `https://www.reddit.com/submit?url=${u}&title=${t}`, path: 'M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286C.775 23.225 1.097 24 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0Zm4.388 3.199c1.104 0 1.999.895 1.999 1.999 0 1.105-.895 2-1.999 2-.946 0-1.739-.657-1.947-1.539v.002c-1.147.162-2.032 1.15-2.032 2.341v.007c1.776.067 3.4.567 4.686 1.363.473-.363 1.064-.58 1.707-.58 1.547 0 2.802 1.254 2.802 2.802 0 1.117-.655 2.081-1.601 2.531-.088 3.256-3.637 5.876-7.997 5.876-4.361 0-7.905-2.617-7.998-5.87-.954-.447-1.614-1.415-1.614-2.538 0-1.548 1.255-2.802 2.803-2.802.645 0 1.239.218 1.712.585 1.275-.79 2.881-1.291 4.64-1.365v-.01c0-1.663 1.263-3.034 2.88-3.207.188-.911.993-1.595 1.959-1.595Zm-8.085 8.376c-.784 0-1.459.78-1.506 1.797-.047 1.016.64 1.429 1.426 1.429.786 0 1.371-.369 1.418-1.385.047-1.017-.553-1.841-1.338-1.841Zm7.406 0c-.786 0-1.385.824-1.338 1.841.047 1.017.634 1.385 1.418 1.385.785 0 1.473-.413 1.426-1.429-.046-1.017-.721-1.797-1.506-1.797Zm-3.703 4.013c-.974 0-1.907.048-2.77.135-.147.015-.241.168-.183.305.483 1.154 1.622 1.964 2.953 1.964 1.33 0 2.47-.81 2.953-1.964.057-.137-.037-.29-.184-.305-.863-.087-1.795-.135-2.769-.135Z' },
];
---
<div class="share" data-url={url}>
  <span class="share-label">Share</span>
  {targets.map((s) => <a class="share-btn" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${s.name}`}><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d={s.path} /></svg>{s.name}</a>)}
  <a class="share-btn" href={`mailto:?subject=${t}&body=${u}`}><Mail size={15} aria-hidden="true" /> Email</a>
  <button type="button" class="share-btn" data-copy><Link size={15} aria-hidden="true" /> <span>Copy link</span></button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.share').forEach((box) => {
    const button = box.querySelector<HTMLButtonElement>('[data-copy]')!;
    const label = button.querySelector('span')!;
    button.addEventListener('click', async () => {
      const url = box.dataset.url!;
      try {
        await navigator.clipboard.writeText(url);
        label.textContent = 'Copied!';
      } catch {
        window.prompt('Copy this link:', url);
        return;
      }
      setTimeout(() => (label.textContent = 'Copy link'), 2000);
    });
  });
</script>

<style>
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin: 1.2rem 0; }
  .share-label { font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #53696b; margin-right: .2rem; }
  .share-btn { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .8rem; border: 1px solid #c9d1cd; border-radius: 999px; background: #fff; color: #244045; font: inherit; font-size: .85rem; text-decoration: none; cursor: pointer; }
  .share-btn:hover { background: #ecf0ec; }
</style>
