---
import { KIND_LABELS, type BusinessFormValues } from '../lib/businesses';

interface Props {
  values: BusinessFormValues;
  errors: string[];
  submitLabel: string;
}

const { values, errors, submitLabel } = Astro.props;
---
<form class="form" method="post">
  {errors.length > 0 && <div class="message" role="alert"><strong>Please fix:</strong><ul style="margin:.4rem 0 0">{errors.map((e) => <li>{e}</li>)}</ul></div>}
  <label>Name <input name="name" value={values.name} required minlength="2" maxlength="120" /></label>
  <label>Type
    <select name="kind" required>
      <option value="" disabled selected={!values.kind}>Choose…</option>
      {Object.entries(KIND_LABELS).map(([key, label]) => <option value={key} selected={values.kind === key}>{label}</option>)}
    </select>
  </label>
  <div class="row">
    <label>Website <input name="website" value={values.website} maxlength="300" placeholder="example.com" /></label>
    <label>Contact email <input name="email" type="email" value={values.email} maxlength="254" /></label>
    <label>Phone <input name="phone" type="tel" value={values.phone} maxlength="40" /></label>
  </div>
  <label>Notes <span class="meta" style="font-weight:400">(staff only)</span><textarea name="notes" maxlength="2000" style="min-height:100px">{values.notes}</textarea></label>
  <div><button class="button small" type="submit">{submitLabel}</button></div>
</form>

<style>
  .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
</style>
