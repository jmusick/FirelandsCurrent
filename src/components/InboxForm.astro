---
interface Props { kind: import('../lib/inbox').InboxKind; subjectLabel: string; bodyLabel: string; submitLabel: string; }
import { env } from 'cloudflare:workers';
const { kind, subjectLabel, bodyLabel, submitLabel } = Astro.props;
const sent = Astro.url.searchParams.get('sent');
const error = Astro.url.searchParams.get('error');
const user = Astro.locals.user;
---
{sent && <p class="message" role="status">Thanks, your message was sent. We'll follow up by email if we need more.</p>}
{error && <p class="message" role="alert">{error === 'captcha' ? 'Please complete the human check and try again.' : error === 'captcha_unavailable' ? 'We could not run the human check right now. Please try again in a moment.' : error === 'send' ? 'We could not send your message right now. Please try again in a few minutes.' : 'Please fill in every field: a valid email, a subject of 3–120 characters, and a message of 20–10,000 characters.'}</p>}
<form class="form" method="post" action="/api/inbox">
  <input type="hidden" name="kind" value={kind} />
  <label class="hp" aria-hidden="true">Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label>
  <label>Your name <input name="name" required maxlength="100" autocomplete="name" value={user?.name} /></label>
  <label>Your email <input name="email" type="email" required maxlength="200" autocomplete="email" value={user?.email} /></label>
  <label>{subjectLabel} <input name="subject" required minlength="3" maxlength="120" /></label>
  <label>{bodyLabel} <textarea name="body" required minlength="20" maxlength="10000"></textarea></label>
  {kind === 'news' && <label class="credit-choice"><input type="checkbox" name="credit_requested" value="1" /><span>Please credit me if this tip is used in a story.</span></label>}
  <div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-action="inbox"></div>
  <button class="button" type="submit">{submitLabel}</button>
</form>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<style>
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .credit-choice { display: flex !important; grid-template-columns: auto 1fr; align-items: start; gap: .6rem !important; }
  .credit-choice input { width: auto; margin-top: .25rem; }
</style>
