---
import { env } from 'cloudflare:workers';
import AdSlot from '../components/AdSlot.astro';
import { pageTakesAds } from '../lib/ads';

interface Props {
  title: string;
  description?: string;
  /** Shown when the page is shared on social media, e.g. a story's lead image. */
  image?: { url: string; width: number; height: number; alt: string } | null;
  type?: 'website' | 'article';
}

const { title, description = 'Independent local news and conversation for Sandusky and the Firelands.', image, type = 'website' } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const user = Astro.locals.user;
const staffRole = Astro.locals.staffRole;
const showAds = pageTakesAds(Astro.url.pathname);
// Only production builds report to Google Analytics, so local development doesn't count as traffic.
const gaId = import.meta.env.PROD && /^G-[A-Z0-9]+$/.test(env.GA_MEASUREMENT_ID ?? '') ? env.GA_MEASUREMENT_ID : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {gaId && <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        // define:vars wraps this script in a function, so gtag is set on window explicitly for later event calls.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>}
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Firelands Current" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {image && <>
      <meta property="og:image" content={new URL(image.url, Astro.url.origin).href} />
      <meta property="og:image:width" content={String(image.width)} />
      <meta property="og:image:height" content={String(image.height)} />
      {image.alt && <meta property="og:image:alt" content={image.alt} />}
    </>}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
    <link rel="alternate" type="application/rss+xml" title="Firelands Current" href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title="Firelands Current (JSON Feed)" href="/feed.json" />
    <title>{title} | Firelands Current</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <slot name="head" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root { font-family: 'DM Sans', sans-serif; color: #172f36; background: #f7f5ef; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; }
      a { color: #15596b; }
      button, input, textarea { font: inherit; }
      button { cursor: pointer; }
      .site-header { background: #f7f5ef; border-bottom: 1px solid #c9d1cd; }
      .topline { background: #173d4a; color: #edf2ed; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; }
      .topline-inner { max-width: 1180px; margin: auto; padding: .55rem 1.25rem; display: flex; justify-content: space-between; gap: 1rem; }
      .masthead { max-width: 1180px; margin: auto; padding: 1.55rem 1.25rem 1.2rem; display: flex; justify-content: space-between; align-items: end; gap: 1rem; }
      .brand { display: inline-flex; align-items: center; gap: .85rem; color: #173d4a; text-decoration: none; font: 700 clamp(1.8rem, 5vw, 3.35rem)/1 'Libre Baskerville', Georgia, serif; letter-spacing: -.06em; }
      .brand-mark { display: block; width: clamp(2.7rem, 5vw, 4rem); height: auto; flex: none; }
      .brand-text { display: block; }
      .brand-text span { color: #bc633e; }
      .masthead p { margin: 0; color: #617277; font-size: .82rem; text-align: right; }
      .nav { border-top: 1px solid #c9d1cd; }
      .nav-inner { max-width: 1180px; margin: auto; padding: .75rem 1.25rem; display: flex; flex-wrap: wrap; gap: 1.4rem; align-items: center; }
      .nav a { text-decoration: none; color: #173d4a; font-weight: 700; font-size: .85rem; text-transform: uppercase; letter-spacing: .06em; }
      .nav .right { margin-left: auto; }
      .nav a:hover { color: #ad5835; }
      main { width: 100%; max-width: 1180px; margin: 0 auto; padding: 2rem 1.25rem 5rem; flex: 1 0 auto; }
      h1, h2, h3 { font-family: 'Libre Baskerville', Georgia, serif; color: #173d4a; line-height: 1.2; }
      h1 { font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -.055em; margin: .2rem 0 1rem; }
      h2 { font-size: 1.55rem; letter-spacing: -.03em; }
      .eyebrow { color: #ad5835; font-weight: 700; font-size: .76rem; letter-spacing: .15em; text-transform: uppercase; }
      .lede { font-size: 1.15rem; line-height: 1.7; color: #4d6367; max-width: 740px; }
      .button { display: inline-block; background: #173d4a; color: white; border: 1px solid #173d4a; border-radius: 3px; padding: .8rem 1.1rem; text-decoration: none; font-weight: 700; }
      .button:hover { background: #245668; }
      .button.secondary { background: transparent; color: #173d4a; }
      .button.secondary:hover { background: #e9eeea; }
      .button.small { padding: .5rem .75rem; font-size: .85rem; }
      .card { background: #fffdfa; border: 1px solid #d9dfda; border-radius: 4px; padding: 1.4rem; }
      .muted { color: #62767a; }
      .meta { color: #687a7d; font-size: .84rem; }
      .form { max-width: 580px; display: grid; gap: 1rem; }
      .form label { display: grid; gap: .4rem; font-weight: 700; font-size: .9rem; }
      .form input, .form textarea { width: 100%; padding: .8rem .85rem; border: 1px solid #9eb0ae; border-radius: 3px; background: #fff; color: #172f36; }
      .form textarea { min-height: 180px; resize: vertical; line-height: 1.5; }
      .form input:focus, .form textarea:focus { outline: 2px solid #61a9b6; outline-offset: 1px; }
      .message { padding: .75rem 1rem; border: 1px solid #d69f80; color: #853d26; background: #fff4ec; }
      .ad-band { border-bottom: 1px solid #e0e4df; padding: .9rem 1.25rem; background: #f2f1ea; }
      .ad-band + main { padding-top: 1.6rem; }
      .site-footer { border-top: 1px solid #c9d1cd; background: #ecf0ec; color: #53696b; padding: 2rem 1.25rem; }
      .site-footer-inner { max-width: 1180px; margin: auto; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; font-size: .85rem; }
      @media(max-width: 700px) { .masthead { display: block; } .masthead p { text-align: left; margin-top: .65rem; } .topline-inner span:last-child { display: none; } .nav .right { margin-left: 0; } }
      @media(max-width: 440px) { .brand { gap: .55rem; font-size: 1.4rem; } .brand-mark { width: 2.5rem; } }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="topline"><div class="topline-inner"><span>Independent news for Ohio's Firelands</span><span>Sandusky and the surrounding region</span></div></div>
      <div class="masthead"><a class="brand" href="/" aria-label="Firelands Current home"><img class="brand-mark" src="/logo-mark.svg" alt="" width="64" height="64" /><span class="brand-text">Firelands <span>Current</span></span></a><p>Local stories. Common ground.</p></div>
      <nav class="nav" aria-label="Main navigation"><div class="nav-inner">
        <a href="/">Home</a><a href="/news">News</a><a href="/events">Events</a><a href="/talk">Talk of the Town</a>
        {staffRole && <a class="right" href="/admin/news">Newsroom</a>}
        {user ? <a class={staffRole ? undefined : "right"} href="/account">{user.name}</a> : <a class="right" href="/sign-in">Sign in</a>}
      </div></nav>
    </header>
    {showAds && <div class="ad-band"><AdSlot placement="site-leaderboard" /></div>}
    <main><slot /></main>
    <footer class="site-footer"><div class="site-footer-inner"><span>© {new Date().getFullYear()} Firelands Current · Owned and operated by <a href="https://stonedragonmedia.com/">Stone Dragon Media, LLC</a> · v{__APP_VERSION__}</span><span>Independent local reporting and conversation · <a href="/submit-news">Submit news</a> · <a href="/contact">Contact</a> · <a href="/advertise">Advertise</a> · <a href="https://www.facebook.com/people/Firelands-Current/61594659460586/" rel="me noopener" target="_blank">Facebook</a> · <a href="https://x.com/FirelandCurrent" rel="me noopener" target="_blank">X</a> · <a href="/rss.xml">RSS</a> · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span></div></footer>
  </body>
</html>
