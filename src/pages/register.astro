---
import BaseLayout from '../layouts/BaseLayout.astro';
if (Astro.locals.user) return Astro.redirect('/account');
---
<BaseLayout title="Create an account">
  <span class="eyebrow">Join the conversation</span>
  <h1>Create an account</h1>
  <p class="lede">Your account has its own Firelands Current ID. Use it to join Talk of the Town and, later, other community features.</p>
  <form id="register-form" class="form">
    <label>Display name <input name="name" required minlength="2" maxlength="60" autocomplete="nickname" /></label>
    <label>Email address <input name="email" type="email" required autocomplete="email" /></label>
    <label>Password <input name="password" type="password" required minlength="12" autocomplete="new-password" /><span class="muted" style="font-weight:400">At least 12 characters.</span></label>
    <div id="form-message" class="message" role="alert" hidden></div>
    <button class="button" type="submit">Create account</button>
  </form>
  <p>Already registered? <a href="/sign-in">Sign in</a>.</p>
  <script>
    import { authClient } from '../lib/auth-client';
    const form = document.querySelector<HTMLFormElement>('#register-form')!;
    const message = document.querySelector<HTMLElement>('#form-message')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      message.hidden = true;
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const password = String(data.get('password') ?? '');
      if (name.length < 2 || name.length > 60) { message.textContent = 'Use a display name between 2 and 60 characters.'; message.hidden = false; return; }
      const result = await authClient.signUp.email({ name, email, password });
      if (result.error) { message.textContent = result.error.message || 'Could not create your account.'; message.hidden = false; return; }
      window.location.assign('/account');
    });
  </script>
</BaseLayout>
