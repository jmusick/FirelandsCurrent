---
import BaseLayout from '../../layouts/BaseLayout.astro';
if (!Astro.locals.user) return Astro.redirect('/sign-in?next=/talk/new');
const error = Astro.url.searchParams.get('error');
---
<BaseLayout title="Start a discussion">
  <a href="/talk">← Talk of the Town</a>
  <span class="eyebrow" style="display:block;margin-top:2rem">New discussion</span>
  <h1>Start a discussion</h1>
  <p class="lede">Choose a clear title and give neighbors enough context to join in. Your display name will appear beside your post.</p>
  {error && <p class="message" role="alert">{error === 'rate' ? 'You have started several discussions recently. Please try again later.' : 'Use a title of 8–140 characters and a message of 20–10,000 characters.'}</p>}
  <form class="form" method="post" action="/api/talk/threads">
    <label>Title <input name="title" required minlength="8" maxlength="140" /></label>
    <label>Your message <textarea name="body" required minlength="20" maxlength="10000"></textarea></label>
    <button class="button" type="submit">Post discussion</button>
  </form>
</BaseLayout>
