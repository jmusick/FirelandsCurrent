---
import AdSlot from '../../components/AdSlot.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { feedAdBreaks } from '../../lib/ads';
import { KIND_LABELS, THREAD_KINDS, listThreads, threadKind } from '../../lib/forum';

const requestedPage = Number(Astro.url.searchParams.get('page') ?? 1);
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 && requestedPage <= 10000 ? requestedPage : 1;
const kind = threadKind(Astro.url.searchParams.get('type'));
const fetched = await listThreads(page - 1, Astro.locals.user?.id ?? '', kind);
const hasMore = fetched.length > 20;
const threads = fetched.slice(0, 20);
const adAfter = new Set(feedAdBreaks(threads.length));
const user = Astro.locals.user;
// Filter and page are kept in every link, so the filter survives paging.
const href = (over: { type?: string | null; page?: number }) => {
  const params = new URLSearchParams();
  const type = over.type === undefined ? kind : over.type;
  if (type) params.set('type', type);
  if (over.page && over.page > 1) params.set('page', String(over.page));
  return params.size ? `/talk?${params}` : '/talk';
};
---
<BaseLayout title="Talk of the Town" description="Local conversations from Sandusky and communities across the Firelands.">
  <div style="display:flex;justify-content:space-between;align-items:end;gap:1rem;flex-wrap:wrap">
    <div><span class="eyebrow">Community discussion</span><h1>Talk of the Town</h1><p class="lede">A place for neighbors to discuss what is happening across Sandusky and the surrounding region.</p></div>
    <a class="button" href={user ? '/talk/new' : '/sign-in?next=/talk/new'}>Start a discussion</a>
  </div>
  <nav class="filters" aria-label="Kinds of discussion">
    <a href={href({ type: null })} aria-current={kind === null ? 'page' : undefined}>All</a>
    {Object.entries(THREAD_KINDS).map(([key, label]) => <a href={href({ type: key })} aria-current={kind === key ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div style="border-top:3px solid #173d4a;margin-top:1rem">
    {threads.length === 0 ? <div class="card" style="margin-top:1rem"><h2>The conversation starts here</h2><p class="muted">{kind ? 'Nothing here yet.' : 'No discussions yet.'} Start the first one about something your neighbors should know or talk about.</p></div> : threads.map((thread, i) => <><article style="padding:1.4rem 0;border-bottom:1px solid #c9d1cd"><h2 style="margin:.2rem 0"><a href={`/talk/${thread.id}`} style="text-decoration:none;color:inherit">{thread.title}</a></h2><p class="meta">{thread.kind === 'community' ? `Started by ${thread.author_name}` : KIND_LABELS[thread.kind]} · {new Date(thread.created_at).toLocaleDateString('en-US', { dateStyle: 'medium' })} · {thread.score} {Math.abs(thread.score) === 1 ? 'point' : 'points'} · {thread.reply_count} {thread.reply_count === 1 ? 'comment' : 'comments'}</p><p class="muted" style="max-width:790px">{thread.body.length > 240 ? thread.body.slice(0, 240) + '…' : thread.body}</p></article>{adAfter.has(i + 1) && <AdSlot placement="talk-feed" />}</>)}
  </div>
  {(page > 1 || hasMore) && <nav aria-label="Discussion pages" style="display:flex;justify-content:space-between;margin-top:1.5rem"><span>{page > 1 && <a href={href({ page: page - 1 })}>← Newer discussions</a>}</span><span>{hasMore && <a href={href({ page: page + 1 })}>Older discussions →</a>}</span></nav>}
</BaseLayout>

<style>
  .filters { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 1.6rem; }
  .filters a { padding: .4rem .9rem; border: 1px solid #9eb0ae; border-radius: 999px; text-decoration: none; color: #173d4a; font-size: .9rem; font-weight: 700; }
  .filters a:hover { background: #e9eeea; }
  .filters a[aria-current] { background: #173d4a; border-color: #173d4a; color: #fff; }
</style>
