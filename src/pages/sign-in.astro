---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialButtons from '../components/SocialButtons.astro';
import { authErrorMessage } from '../lib/auth-errors';
const errorCode = Astro.url.searchParams.get('error');
// A failed link happens while signed in, so carry the error to the account page instead of dropping it.
if (Astro.locals.user) return Astro.redirect(errorCode ? `/account?error=${encodeURIComponent(errorCode)}` : '/account');
const reset = Astro.url.searchParams.get('reset');
const errorMessage = authErrorMessage(errorCode);
---
<BaseLayout title="Sign in">
  <h1>Sign in</h1>
  {reset && <p class="message" role="status">Your password was changed. Sign in with the new one.</p>}
  {errorMessage && <p class="message" role="alert">{errorMessage}</p>}
  <form id="sign-in-form" class="form">
    <label>Email address <input name="email" type="email" required autocomplete="email" /></label>
    <label>Password <input name="password" type="password" required autocomplete="current-password" /></label>
    <div id="form-message" class="message" role="alert" hidden></div>
    <button class="button" type="submit">Sign in</button>
  </form>
  <p><a href="/forgot-password">Forgot your password?</a></p>
  <SocialButtons verb="Sign in" />
  <p>New here? <a href="/register">Create an account</a>.</p>
  <script>
    import { authClient } from '../lib/auth-client';
    const form = document.querySelector<HTMLFormElement>('#sign-in-form')!;
    const message = document.querySelector<HTMLElement>('#form-message')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      message.hidden = true;
      const data = new FormData(form);
      const result = await authClient.signIn.email({ email: String(data.get('email') ?? ''), password: String(data.get('password') ?? ''), callbackURL: '/account?verified=1' });
      if (result.error) {
        // Better Auth has already mailed a fresh link by the time it reports this.
        message.textContent = result.error.code === 'EMAIL_NOT_VERIFIED'
          ? 'Confirm your email address first. We just sent a new confirmation link to your inbox.'
          : result.error.message || 'Sign in failed.';
        message.hidden = false;
        return;
      }
      const next = new URLSearchParams(window.location.search).get('next');
      window.location.assign(next && next.startsWith('/') && !next.startsWith('//') ? next : '/account');
    });
  </script>
</BaseLayout>
