---
import AdSlot from '../components/AdSlot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, fmtDay, fmtHours, listEvents, today } from '../lib/events';
import { SECTIONS, frontPageArticles, leadMedia } from '../lib/news';

const { lead, more } = await frontPageArticles();
const leadImage = lead ? leadMedia(lead) : null;
const events = (await listEvents({}, 0, 4)).slice(0, 4);
const now = today();
---
<BaseLayout title="Home">
  {lead ? <section class="front">
    <article style="min-width:0;max-width:760px">
      {leadImage && <a class="front-image" href={`/news/${lead.slug}`} tabindex="-1" aria-hidden="true"><img src={`/media/${leadImage.object_key}`} alt="" width={leadImage.width} height={leadImage.height} fetchpriority="high" /></a>}
      <span class="eyebrow">{SECTIONS[lead.section]} · {lead.community}</span>
      <h1 style="margin-top:.4rem"><a href={`/news/${lead.slug}`} style="text-decoration:none;color:inherit">{lead.headline}</a></h1>
      <p class="lede" style="margin-top:0">{lead.summary}</p>
      <p class="meta">By {lead.byline} · {new Date(lead.published_at).toLocaleDateString('en-US', { dateStyle: 'medium' })}</p>
      <p class="read-more"><a href={`/news/${lead.slug}`}>Read the full story →</a></p>
    </article>
    <div style="border-top:3px solid #173d4a;min-width:0">
      {more.map((article) => <article style="padding:1rem 0;border-bottom:1px solid #c9d1cd"><span class="eyebrow">{SECTIONS[article.section]}</span><h3 style="margin:.3rem 0;font-size:1.1rem"><a href={`/news/${article.slug}`} style="text-decoration:none;color:inherit">{article.headline}</a></h3><p class="meta" style="margin:0">{article.community} · {new Date(article.published_at).toLocaleDateString('en-US', { dateStyle: 'medium' })}</p></article>)}
      <p><a href="/news">All the latest news →</a></p>
      <AdSlot placement="home-rail" class="home-rail" />
    </div>
  </section> : <section style="max-width:850px;padding:2.5rem 0 3rem;border-bottom:1px solid #c9d1cd">
    <span class="eyebrow">A new local newspaper</span>
    <h1>The region's stories belong here.</h1>
    <p class="lede">Firelands Current is taking shape as an independent home for news and conversation centered on Sandusky and the communities around it.</p>
    <a class="button" href="/talk">Visit Talk of the Town</a>
  </section>}
  <div class="home-billboard"><AdSlot placement="home-billboard" /></div>
  {events.length > 0 && <section class="coming-up" aria-labelledby="coming-up">
    <div class="coming-up-head"><h2 id="coming-up">Coming up</h2><a href="/events">Full events calendar →</a></div>
    <div class="coming-up-list">
      {events.map((e) => <article>
        <p class="when">{e.starts_on <= now ? 'Today' : fmtDay(e.starts_on, { weekday: 'short', month: 'short', day: 'numeric' })} · {fmtHours(e)}</p>
        <h3><a href={`/events/${e.slug}`}>{e.title}</a></h3>
        <p class="meta">{e.status === 'cancelled' ? <strong>Cancelled</strong> : CATEGORIES[e.category]} · {e.venue}, {e.community}</p>
      </article>)}
    </div>
  </section>}
  <section style="padding-top:2.5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem">
    <div class="card"><span class="eyebrow">Local reporting</span><h2>News with a local address</h2><p class="muted">Coverage begins with Sandusky and extends across roughly 50 miles of the Firelands region.</p><a href="/news">Read the news →</a></div>
    <div class="card"><span class="eyebrow">Calendar</span><h2>Local events</h2><p class="muted">Concerts, festivals, markets and public meetings around Sandusky and the Firelands.</p><a href="/events">See what’s happening →</a></div>
    <div class="card"><span class="eyebrow">Community</span><h2>Talk of the Town</h2><p class="muted">Start a discussion, share what is happening, and hear from neighbors. A free account is needed to post.</p><a href="/talk">Browse discussions →</a></div>
  </section>
</BaseLayout>

<style>
  .front { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 2.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid #c9d1cd; }
  .read-more { margin: .9rem 0 0; font-weight: 700; }
  .front-image img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 4px; background: #ecf0ec; margin-bottom: 1.1rem; }
  .home-billboard { padding: 2rem 0 0; }
  .coming-up { padding-top: 2.5rem; }
  .coming-up-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; border-bottom: 3px solid #173d4a; }
  .coming-up-head h2 { margin: 0 0 .5rem; }
  .coming-up-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0 1.5rem; }
  .coming-up-list article { padding: 1rem 0; border-bottom: 1px solid #c9d1cd; min-width: 0; }
  .coming-up .when { margin: 0; color: #ad5835; font-weight: 700; font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
  .coming-up h3 { margin: .35rem 0; font-size: 1.1rem; }
  .coming-up h3 a { text-decoration: none; color: inherit; }
  .coming-up .meta { margin: 0; }
  :global(.home-rail) { margin-top: 1.5rem; }
  @media (max-width: 800px) { .front { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; } }
</style>
