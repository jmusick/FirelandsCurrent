---
import { ChevronLeft, ChevronRight, Upload } from '@lucide/astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import MediaUploadForm from '../../../components/MediaUploadForm.astro';
import { ADMIN, requireSection } from '../../../lib/admin';
import { MEDIA_PAGE_SIZE, fmtBytes, listMedia, mediaUrl } from '../../../lib/media';

const denied = requireSection(Astro, ADMIN.media);
if (denied) return denied;

const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const page = Math.max(0, Math.min(1000, Number(Astro.url.searchParams.get('page')) || 0));
const rows = await listMedia(q, page);
const items = rows.slice(0, MEDIA_PAGE_SIZE);
const hasNext = rows.length > MEDIA_PAGE_SIZE;
const deleted = Astro.url.searchParams.get('deleted');
const pageUrl = (p: number) => `/admin/media?${new URLSearchParams({ ...(q && { q }), ...(p && { page: String(p) }) })}`;
---
<AdminLayout title="Media">
  <div style="display:flex;justify-content:space-between;align-items:end;gap:1rem;flex-wrap:wrap">
    <div><span class="eyebrow">Media</span><h1>Media library</h1></div>
    <a class="button" href="#upload"><Upload />Upload image</a>
  </div>
  <p class="muted" style="max-width:760px;margin-top:0">Every image used in stories and ads. Each one carries a credit, shown with it on the site, and a staff-only note on where it came from and who allowed its use.</p>
  {deleted && <p class="message" role="status">Deleted {deleted}.</p>}

  <form class="filters" method="get" action="/admin/media">
    <input name="q" type="search" value={q} placeholder="Search file name, alt text, caption or credit…" aria-label="Search media" />
    <button class="button small" type="submit">Search</button>
    {q && <a href="/admin/media">Clear</a>}
  </form>

  {items.length === 0 ? <div class="card"><p class="muted" style="margin:0">{q ? 'No images match that search.' : 'No images yet. Upload the first one below.'}</p></div> :
  <ul class="grid">
    {items.map((m) => <li>
      <a href={`/admin/media/${m.id}`}>
        <img src={mediaUrl(m.object_key)} alt="" loading="lazy" />
        <span class="name">{m.filename}</span>
        <span class="meta">{m.width}×{m.height} · {fmtBytes(m.bytes)}</span>
        <span class="meta credit">{m.credit}</span>
      </a>
    </li>)}
  </ul>}

  {(page > 0 || hasNext) && <nav class="pager" aria-label="Pages">
    {page > 0 ? <a class="button secondary small" href={pageUrl(page - 1)}><ChevronLeft />Previous</a> : <span></span>}
    <span class="meta">Page {page + 1}</span>
    {hasNext ? <a class="button secondary small" href={pageUrl(page + 1)}>Next<ChevronRight /></a> : <span></span>}
  </nav>}

  <section id="upload" class="card upload">
    <h2><Upload />Upload an image</h2>
    <MediaUploadForm />
  </section>
</AdminLayout>

<script>
  document.addEventListener('media-uploaded', (event) => {
    location.href = `/admin/media/${(event as CustomEvent<{ id: string }>).detail.id}?notice=uploaded`;
  });
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin: 1.25rem 0 1rem; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; }
  .grid a { display: grid; gap: .25rem; padding: .5rem; border: 1px solid #d9dfda; border-radius: 4px; background: #fffdfa; color: inherit; text-decoration: none; min-width: 0; }
  .grid a:hover { border-color: #9eb0ae; }
  .grid img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: #ecf0ec; border-radius: 2px; margin-bottom: .2rem; }
  .name { font-weight: 700; color: #173d4a; font-size: .88rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .grid .meta { font-size: .78rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .credit { color: #ad5835; }
  .pager { display: flex; justify-content: space-between; align-items: center; margin-top: 1.25rem; }
  .upload { max-width: 760px; margin-top: 2.5rem; }
  .upload h2 { margin-top: 0; font-size: 1.2rem; }
</style>
