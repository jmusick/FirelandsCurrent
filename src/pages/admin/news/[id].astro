---
import { readForm, STORY_FORM_BYTES } from '../../../lib/request-body';
import { ArrowLeft } from '@lucide/astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import NewsEditor from '../../../components/NewsEditor.astro';
import { ADMIN, requireSection } from '../../../lib/admin';
import { openCorrectionsFor } from '../../../lib/corrections';
import { sameOrigin } from '../../../lib/forum';
import { getAdminArticle } from '../../../lib/news';
import { saveArticleFromForm, valuesFromArticle } from '../../../lib/news-admin';

const denied = requireSection(Astro, ADMIN.news);
if (denied) return denied;

const article = await getAdminArticle(Astro.params.id ?? '');
if (!article) return new Response('Story not found', { status: 404 });

let values = valuesFromArticle(article);
let errors: string[] = [];
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) return new Response('Invalid request origin', { status: 403 });
  const form = await readForm(Astro.request, STORY_FORM_BYTES);
  if (form instanceof Response) return form;
  const result = await saveArticleFromForm(form, article);
  if (result.ok) return Astro.redirect(`/admin/news/${result.id}?saved=1`, 303);
  ({ values, errors } = result);
}
const corrections = await openCorrectionsFor('news', article.id);
const liveUrl = article.status === 'published' ? `/news/${article.slug}` : null;
---
<AdminLayout title={`Edit: ${article.headline}`}>
  <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.21.0/dist/easymde.min.css" />
  <a class="back" href="/admin/news"><ArrowLeft />All stories</a>
  <span class="eyebrow" style="display:block;margin-top:1.5rem">News · {article.status === 'published' ? 'Published' : 'Draft'}</span>
  <h1>Edit story</h1>
  <p class="meta">Last saved {new Date(article.updated_at).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}{liveUrl && <> · <a href={liveUrl}>View on site</a></>}</p>
  {corrections.length > 0 && <p class="message" role="status"><strong>{corrections.length} open correction {corrections.length === 1 ? 'report' : 'reports'}:</strong> {corrections.map((c, i) => <>{i > 0 && ', '}<a href={`/admin/corrections/${c.id}`}>review {i + 1}</a></>)}</p>}
  <NewsEditor values={values} errors={errors} saved={Astro.url.searchParams.has('saved') && !errors.length} articleId={article.id} liveUrl={liveUrl} canDelete={Astro.locals.staffRole === 'admin'} />
</AdminLayout>
