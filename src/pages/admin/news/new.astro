---
import { ArrowLeft } from '@lucide/astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import NewsEditor from '../../../components/NewsEditor.astro';
import { ADMIN, requireSection } from '../../../lib/admin';
import { sameOrigin } from '../../../lib/forum';
import { env } from 'cloudflare:workers';
import { emptyArticle, saveArticleFromForm, type ArticleFormValues } from '../../../lib/news-admin';

const denied = requireSection(Astro, ADMIN.news);
if (denied) return denied;

let values: ArticleFormValues = { ...emptyArticle, byline: Astro.locals.user!.name };
let errors: string[] = [];
const submissionId = Astro.url.searchParams.get('submission') ?? '';
if (submissionId && /^[\w-]{8,64}$/.test(submissionId)) {
  const tip = await env.DB.prepare("SELECT * FROM news_submissions WHERE id = ? AND status != 'converted'").bind(submissionId).first<{ id: string; name: string; subject: string; body: string; credit_requested: number }>();
  if (tip) values = { ...values, headline: tip.subject.slice(0, 160), summary: tip.body.replace(/\s+/g, ' ').slice(0, 400), body: tip.body.slice(0, 50000), byline: tip.credit_requested ? tip.name.slice(0, 80) : Astro.locals.user!.name };
}
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) return new Response('Invalid request origin', { status: 403 });
  const form = await Astro.request.formData();
  const result = await saveArticleFromForm(form, null);
  if (result.ok) {
    const linkedSubmission = form.get('submission_id')?.toString() ?? '';
    if (/^[\w-]{8,64}$/.test(linkedSubmission)) await env.DB.prepare("UPDATE news_submissions SET status = 'converted', article_id = ?, updated_at = ? WHERE id = ? AND status != 'converted'").bind(result.id, Date.now(), linkedSubmission).run();
    return Astro.redirect(`/admin/news/${result.id}?saved=1`, 303);
  }
  ({ values, errors } = result);
}
---
<AdminLayout title="New story">
  <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.21.0/dist/easymde.min.css" />
  <a class="back" href="/admin/news"><ArrowLeft />All stories</a>
  <span class="eyebrow" style="display:block;margin-top:1.5rem">News</span>
  <h1>New story</h1>
  <NewsEditor values={values} errors={errors} submissionId={submissionId} />
</AdminLayout>
