---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ADMIN, canAccess, requireSection } from '../../lib/admin';

const denied = requireSection(Astro, ADMIN.dashboard);
if (denied) return denied;

const stats = await env.DB.prepare(`
  SELECT
    (SELECT COUNT(*) FROM news_articles WHERE status = 'published') AS published,
    (SELECT COUNT(*) FROM news_articles WHERE status = 'draft') AS drafts,
    (SELECT COUNT(*) FROM forum_threads WHERE status = 'published') AS threads,
    (SELECT COUNT(*) FROM forum_reports WHERE status = 'open') AS reports,
    (SELECT COUNT(*) FROM "user") AS users
`).first<{ published: number; drafts: number; threads: number; reports: number; users: number }>();
const role = Astro.locals.staffRole;
const news = canAccess(role, ADMIN.news);
const talk = canAccess(role, ADMIN.talk);
const users = canAccess(role, ADMIN.users);
---
<AdminLayout title="Dashboard">
  <span class="eyebrow">Admin</span>
  <h1>Dashboard</h1>
  <div class="tiles">
    {news && <a class="card tile" href="/admin/news?status=published"><span class="meta">Published stories</span><strong>{stats?.published ?? 0}</strong></a>}
    {news && <a class="card tile" href="/admin/news?status=draft"><span class="meta">Drafts</span><strong>{stats?.drafts ?? 0}</strong></a>}
    {talk && <a class="card tile" href="/admin/talk"><span class="meta">Open reports</span><strong class={stats?.reports ? 'alert' : undefined}>{stats?.reports ?? 0}</strong></a>}
    <div class="card tile"><span class="meta">Talk of the Town discussions</span><strong>{stats?.threads ?? 0}</strong></div>
    {users ? <a class="card tile" href="/admin/users"><span class="meta">Registered accounts</span><strong>{stats?.users ?? 0}</strong></a> : <div class="card tile"><span class="meta">Registered accounts</span><strong>{stats?.users ?? 0}</strong></div>}
  </div>
  <h2>Quick actions</h2>
  <div style="display:flex;gap:.6rem;flex-wrap:wrap">
    {news && <a class="button" href="/admin/news/new">New story</a>}
    {news && <a class="button secondary" href="/admin/news">Manage stories</a>}
    {talk && <a class="button secondary" href="/admin/talk">Review reports</a>}
    {users && <a class="button secondary" href="/admin/users">Manage users</a>}
  </div>
</AdminLayout>

<style>
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .tile { display: grid; gap: .4rem; text-decoration: none; color: inherit; }
  a.tile:hover { border-color: #9eb0ae; }
  .tile strong { font: 700 2rem 'Libre Baskerville', Georgia, serif; color: #173d4a; }
  .tile strong.alert { color: #ad5835; }
</style>
