---
import { CalendarDays, CalendarPlus, FilePen, Flag, MessagesSquare, Newspaper, Plus, SpellCheck, Users } from '@lucide/astro';
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ADMIN, canAccess, requireSection } from '../../lib/admin';
import { today } from '../../lib/events';

const denied = requireSection(Astro, ADMIN.dashboard);
if (denied) return denied;

const stats = await env.DB.prepare(`
  SELECT
    (SELECT COUNT(*) FROM news_articles WHERE status = 'published') AS published,
    (SELECT COUNT(*) FROM news_articles WHERE status = 'draft') AS drafts,
    (SELECT COUNT(*) FROM news_submissions WHERE status = 'unread') AS unread_tips,
    (SELECT COUNT(*) FROM corrections WHERE status = 'open') AS corrections,
    (SELECT COUNT(*) FROM events WHERE status = 'published' AND COALESCE(ends_on, starts_on) >= ?1) AS events,
    (SELECT COUNT(*) FROM forum_threads WHERE status = 'published') AS threads,
    (SELECT COUNT(*) FROM forum_reports WHERE status = 'open') AS reports,
    (SELECT COUNT(*) FROM "user" WHERE id != 'newsroom') AS users
`).bind(today()).first<{ published: number; drafts: number; unread_tips: number; corrections: number; events: number; threads: number; reports: number; users: number }>();
const role = Astro.locals.staffRole;
const news = canAccess(role, ADMIN.news);
const events = canAccess(role, ADMIN.events);
const talk = canAccess(role, ADMIN.talk);
const users = canAccess(role, ADMIN.users);
---
<AdminLayout title="Dashboard">
  <span class="eyebrow">Admin</span>
  <h1>Dashboard</h1>
  <div class="tiles">
    {news && <a class="card tile" href="/admin/news?status=published"><span class="meta"><Newspaper />Published stories</span><strong>{stats?.published ?? 0}</strong></a>}
    {news && <a class="card tile" href="/admin/news?status=draft"><span class="meta"><FilePen />Drafts</span><strong>{stats?.drafts ?? 0}</strong></a>}
    {news && <a class="card tile" href="/admin/submissions"><span class="meta"><Newspaper />Unread news tips</span><strong class={stats?.unread_tips ? 'alert' : undefined}>{stats?.unread_tips ?? 0}</strong></a>}
    {news && <a class="card tile" href="/admin/corrections"><span class="meta"><SpellCheck />Open corrections</span><strong class={stats?.corrections ? 'alert' : undefined}>{stats?.corrections ?? 0}</strong></a>}
    {events && <a class="card tile" href="/admin/events"><span class="meta"><CalendarDays />Upcoming events</span><strong>{stats?.events ?? 0}</strong></a>}
    {talk && <a class="card tile" href="/admin/talk"><span class="meta"><Flag />Open reports</span><strong class={stats?.reports ? 'alert' : undefined}>{stats?.reports ?? 0}</strong></a>}
    <div class="card tile"><span class="meta"><MessagesSquare />Talk of the Town discussions</span><strong>{stats?.threads ?? 0}</strong></div>
    {users ? <a class="card tile" href="/admin/users"><span class="meta"><Users />Registered accounts</span><strong>{stats?.users ?? 0}</strong></a> : <div class="card tile"><span class="meta"><Users />Registered accounts</span><strong>{stats?.users ?? 0}</strong></div>}
  </div>
  <h2>Quick actions</h2>
  <div style="display:flex;gap:.6rem;flex-wrap:wrap">
    {news && <a class="button" href="/admin/news/new"><Plus />New story</a>}
    {news && <a class="button secondary" href="/admin/news"><Newspaper />Manage stories</a>}
    {events && <a class="button secondary" href="/admin/events/new"><CalendarPlus />New event</a>}
    {talk && <a class="button secondary" href="/admin/talk"><Flag />Review reports</a>}
    {users && <a class="button secondary" href="/admin/users"><Users />Manage users</a>}
  </div>
</AdminLayout>

<style>
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .tile { display: grid; gap: .4rem; text-decoration: none; color: inherit; }
  a.tile:hover { border-color: var(--field); }
  .tile .meta { display: flex; align-items: center; gap: .4rem; }
  .tile .meta .lucide { width: 1rem; height: 1rem; color: var(--channel); }
  .tile strong { font: 700 2rem var(--scan); font-stretch: 72%; color: var(--deep); }
  .tile strong.alert { color: var(--alert); }
</style>
