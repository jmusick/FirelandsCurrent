---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ADMIN, requireSection } from '../../../lib/admin';
import { env } from 'cloudflare:workers';

const denied = requireSection(Astro, ADMIN.submissions);
if (denied) return denied;
const rows = await env.DB.prepare(`SELECT s.id, s.name, s.email, s.subject, s.status, s.credit_requested, s.created_at, u.name AS account_name
  FROM news_submissions s LEFT JOIN "user" u ON u.id = s.submitter_user_id ORDER BY s.created_at DESC`).all<any>();
const fmt = (ms: number) => new Date(ms).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });
---
<AdminLayout title="News tips">
  <span class="eyebrow">Newsroom</span><h1>Submitted news</h1>
  <p class="muted">Tips from the public, newest first. Unread tips are shown in bold.</p>
  {rows.results.length ? <div class="table-wrap"><table><thead><tr><th>Topic</th><th>Submitted by</th><th>Status</th><th>Date</th></tr></thead><tbody>
    {rows.results.map((s: any) => <tr><td><a class="headline" href={`/admin/submissions/${s.id}`}>{s.subject}</a></td><td>{s.name}<div class="meta">{s.account_name ? `Account: ${s.account_name}` : s.email}{s.credit_requested ? ' · credit requested' : ''}</div></td><td><span class={`pill ${s.status}`}>{s.status}</span></td><td class="meta">{fmt(s.created_at)}</td></tr>)}
  </tbody></table></div> : <div class="card"><h2>No news tips yet</h2></div>}
</AdminLayout>
<style>
  .table-wrap { overflow-x:auto; border-top:3px solid #173d4a; } table { width:100%; border-collapse:collapse; } th { text-align:left; font-size:.76rem; letter-spacing:.1em; text-transform:uppercase; color:#687a7d; padding:.8rem .6rem; border-bottom:1px solid #c9d1cd; } td { padding:.9rem .6rem; border-bottom:1px solid #c9d1cd; vertical-align:top; } .meta { margin-top:.2rem; } .headline { font-weight:700; color:#173d4a; text-decoration:none; } .headline:hover { text-decoration:underline; } .pill { display:inline-block; padding:.15rem .55rem; border-radius:999px; font-size:.78rem; font-weight:700; text-transform:capitalize; background:#e9eeea; } .pill.unread { background:#fbeee2; color:#853d26; }
</style>
