{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "firelands-current",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SITE_URL": "https://firelandscurrent.com",
    "GA_MEASUREMENT_ID": "G-WCZR3LZNP7",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFIBi9c0_-POqXBd",
    "FACEBOOK_AUTO_POST_ENABLED": "true",
    "FACEBOOK_PAGE_ID": "1342964875571057",
    "FACEBOOK_GRAPH_VERSION": "v26.0",
    "FACEBOOK_TOKEN_EXPIRES_AT": "1796170098000"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [
    { "pattern": "firelandscurrent.com", "custom_domain": true },
    { "pattern": "www.firelandscurrent.com", "custom_domain": true }
  ],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firelands-current",
      "database_id": "d0c7bf96-5f69-4736-b4e0-25bead1b60d3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "firelands-current-media" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
